{
  "name": "github-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server que permite a un agente de IA operar GitHub mediante lenguaje natural",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "github-mcp-server": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts --verbose",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "ai-agents",
    "octokit"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/rest": "^22.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
